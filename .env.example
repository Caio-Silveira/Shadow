# LM Studio: inicie o servidor local e informe o ID do modelo carregado.
SHADOW_LMSTUDIO_MODEL=
SHADOW_LMSTUDIO_URL=http://127.0.0.1:1234/v1/responses
LM_API_TOKEN=
