# Provider: openai or google
SHADOW_PROVIDER=google

# Google Gemini Developer API (free tier available for supported models)
GEMINI_API_KEY=your-google-ai-studio-key
SHADOW_GOOGLE_MODEL=gemini-3.6-flash

# OpenAI
OPENAI_API_KEY=sk-...
SHADOW_OPENAI_MODEL=gpt-5.6-luna

# Shared overrides
# SHADOW_HOME=~/.local/share/shadow
# SHADOW_NODE=~/.nvm/versions/node/v24.15.0/bin/node
# SHADOW_DC_SERVER=~/.local/share/desktop-commander/node_modules/@wonderwhy-er/desktop-commander/dist/index.js
