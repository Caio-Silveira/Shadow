#!/usr/bin/env python3
import os, signal, subprocess, sys, time, wave
from array import array
from pathlib import Path
sec=float(sys.argv[1]) if len(sys.argv)>1 else 12.0
rate=16000; chunk_ms=30; frames=int(rate*chunk_ms/1000); nbytes=frames*2
out=Path('/dev/shm')/f'shadow-audio-{os.getuid()}'/'current.wav'; out.parent.mkdir(mode=0o700,exist_ok=True)
cmd=[str(Path.home()/'.local/bin/gui-run'),'parec','--raw','--rate=16000','--channels=1','--format=s16le']
p=subprocess.Popen(cmd,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL)
buf=[]; started=False; speech_at=None; t0=time.monotonic(); threshold=450
try:
    while time.monotonic()-t0 < sec:
        data=p.stdout.read(nbytes)
        if not data: break
        samples=array("h"); samples.frombytes(data); rms=(sum(x*x for x in samples)/max(1,len(samples)))**0.5; now=time.monotonic()
        if rms>=threshold:
            started=True; speech_at=now
        if started: buf.append(data)
        if started and speech_at and now-speech_at>=0.55 and len(buf)*chunk_ms>=450: break
finally:
    p.terminate()
if not buf: sys.exit(3)
with wave.open(str(out),'wb') as w:
    w.setnchannels(1); w.setsampwidth(2); w.setframerate(rate); w.writeframes(b''.join(buf))
os.chmod(out,0o600); print(out)
